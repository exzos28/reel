<Project Sdk="Microsoft.NET.Sdk">

  <!-- The reel core's service: a .NET Tizen service app (the shape tizen-os-ambilight ships and
       Apps2Samsung installs) whose only job is to load libreel_tizen_core.so (Rust, built by
       ../build.sh into lib/) and keep the process alive. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0-tizen9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ReelCore</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>None</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Rust core, cross-compiled for armv7 by ../build.sh. Packed into the .tpk's lib/,
         which is ApplicationInfo.DirectoryInfo.Lib on the TV. -->
    <TizenTpkUserIncludeFiles Include="lib/libreel_tizen_core.so">
      <TizenTpkSubDir>lib</TizenTpkSubDir>
    </TizenTpkUserIncludeFiles>
  </ItemGroup>

</Project>
