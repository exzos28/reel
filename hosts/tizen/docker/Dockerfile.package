# The whole TV package (hosts/tizen/build.sh package: core + web + .NET service + hybrid .wgt)
# built as .github/workflows/tizen.yml builds it, so the host needs nothing but Docker. amd64:
# the Tizen-Core CLI and the Tizen .NET workload ship for x86-64 Linux only (emulated on Apple
# silicon). Used by scripts/tizen-docker.sh package.
FROM --platform=linux/amd64 ubuntu:24.04
ARG ZIG_VERSION=0.13.0
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git rsync zip unzip xz-utils python3 build-essential pkg-config libssl-dev \
      clang-18 llvm-18 lld-18 libicu74 file binutils \
    && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH=/usr/local/cargo/bin:/usr/share/dotnet:$PATH
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable \
    && rustup target add armv7-unknown-linux-gnueabi wasm32-unknown-unknown
RUN curl -fsSL "https://ziglang.org/download/${ZIG_VERSION}/zig-linux-x86_64-${ZIG_VERSION}.tar.xz" -o /tmp/zig.tar.xz \
    && mkdir -p /opt/zig && tar -xJf /tmp/zig.tar.xz -C /opt/zig --strip-components=1 && rm /tmp/zig.tar.xz \
    && ln -s /opt/zig/zig /usr/local/bin/zig \
    && cargo install --locked cargo-zigbuild && rm -rf /usr/local/cargo/registry
# .NET 8 and the Tizen workload (as actions/setup-dotnet + Samsung's workload-install.sh).
ENV DOTNET_ROOT=/usr/share/dotnet DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
RUN curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
    && bash /tmp/dotnet-install.sh --channel 8.0 --install-dir "$DOTNET_ROOT" \
    && curl -fsSL https://raw.githubusercontent.com/Samsung/Tizen.NET/main/workload/scripts/workload-install.sh -o /tmp/workload-install.sh \
    && bash /tmp/workload-install.sh -d "$DOTNET_ROOT" && dotnet workload list && rm /tmp/*.sh
# Tizen-Core CLI (tz) from the official Tizen SDK repository, checked as CI checks it.
ENV TIZEN_SDK=/opt/tizen-sdk
RUN set -eu; base=https://download.tizen.org/sdk/tizenstudio/official/binary; mkdir -p "$TIZEN_SDK" /tmp/pkg; \
    for pair in \
      "tizen-core_10.0.18_ubuntu-64.zip 08b60e8f630fe0c3aafa5be9251a75d9ce173f2521375ddb803f9a3cb57f62ec" \
      "web-privilege-checker_0.0.2_ubuntu-64.zip 5dce06d92b3f046303f3baabd1e8a4bb6cfb7724e051da5d83205fd6d88f7ccc" \
      "certificate-generator_0.1.4_ubuntu-64.zip 446aa52f249205f4ad573173b02c9c38aa5de0316028b77dd189e44fd5f75964"; do \
      set -- $pair; curl -fsSL -o "/tmp/$1" "$base/$1"; echo "$2  /tmp/$1" | sha256sum -c -; \
      unzip -q -o "/tmp/$1" 'data/*' -d /tmp/pkg; rm "/tmp/$1"; \
    done; \
    cp -R /tmp/pkg/data/. "$TIZEN_SDK/"; rm -rf /tmp/pkg; \
    printf 'TIZEN_SDK_INSTALLED_PATH=%s\nTIZEN_SDK_DATA_PATH=%s\n' "$TIZEN_SDK" "$TIZEN_SDK-data" > "$TIZEN_SDK/sdk.info"; \
    mkdir -p "$TIZEN_SDK-data"; chmod +x "$TIZEN_SDK"/tools/tizen-core/tz "$TIZEN_SDK"/tools/tizen-core/tgn "$TIZEN_SDK"/tools/tizen-core/ninja "$TIZEN_SDK"/tools/tizen-core/web-privilege-checker; \
    "$TIZEN_SDK/tools/tizen-core/tz" --version
# NSH's web runtime compiles C for wasm32: a clang with that backend.
ENV CC_wasm32_unknown_unknown=/usr/lib/llvm-18/bin/clang
WORKDIR /src
