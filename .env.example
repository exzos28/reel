# Local settings for development and for building packages. Copy this file to .env (git-ignored)
# and fill in what you need; everything is optional. Load it from app/ with:
#   set -a; . ../.env; set +a
# scripts/linux-docker.sh and scripts/tizen-docker.sh read it themselves; load it before
# scripts/build.sh and hosts/tizen/build.sh.

# --- Built into the app (read at compile time) -------------------------------------------------

# TMDB API Read Access Token (https://www.themoviedb.org/settings/api). With it the app shows
# films and series out of the box; without it the app asks the user for their own TMDB key.
REEL_TMDB_TOKEN=

# The partner's Telegram bot (its username, without @) that rents a ready search source
# (design/partner-source.md). Without it the app shows no "Rent a ready source".
REEL_PARTNER_BOT=

# How much of mpv's log reaches reel's log: "warn" by default; "info", "v" or "debug" for more.
REEL_MPV_LOG=

# --- For development only (never built into a release) ---------------------------------------

# Your own Torznab search source (a Jackett/Prowlarr endpoint and its API key). Used by the
# network tests (cargo test -- --ignored) and by scripts/tizen-local.sh, which puts it into a
# developer build of the TV app so it does not have to be typed with a remote. reel ships no
# source: release builds never carry one.
REEL_TORZNAB_URL=
REEL_TORZNAB_KEY=

# A libmpv to load instead of the bundled one (a path to libmpv.2.dylib / libmpv.so.2), and a
# media file for the mpv test (cargo test -- --ignored mpv_plays; scripts/mpv-sample.sh makes one).
REEL_LIBMPV=
REEL_MPV_SAMPLE=
